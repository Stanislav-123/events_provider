# Local / public provider host (HTTP, not HTTPS):
# EVENTS_PROVIDER_URL=http://events-provider.dev-2.python-labs.ru
#
# Inside LMS/k8s cluster use the internal service DNS:
EVENTS_PROVIDER_URL=http://student-system-events-provider-web.student-system-events-provider.svc:8000
EVENTS_PROVIDER_API_KEY=your-api-key-from-lms-profile

DATABASE_URL=postgresql+asyncpg://events_user:local_dev_password@127.0.0.1:5432/events_db
SYNC_INTERVAL_SECONDS=86400
SEATS_CACHE_TTL_SECONDS=30
ENABLE_BACKGROUND_SYNC=true
